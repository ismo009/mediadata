APP_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
SHOTGRID_SERVER_URL=https://your-site.shotgrid.autodesk.com
SHOTGRID_LOGIN=
SHOTGRID_PASSPHRASE=
SHOTGRID_PAT=
SHOTGRID_SCRIPT_NAME=
SHOTGRID_SCRIPT_KEY=
# "auto" = every ShotGrid entity type with data, or a list: Project,Shot,Task
SYNC_ENTITIES=auto
# Background incremental sync interval in minutes (0 disables it)
SYNC_INTERVAL_MINUTES=30
# Run a full sync when the last one is older than this
FULL_SYNC_EVERY_HOURS=24
# Context window requested from Ollama (system prompt + data + history + answer)
OLLAMA_NUM_CTX=16384

# --- Sign-in with Autodesk (same account as ShotGrid) ---
# Create a "Traditional Web App" on https://aps.autodesk.com/myapps with this callback URL:
#   <APP_BASE_URL>/auth/autodesk/callback
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Optional: only if the callback URL differs from APP_BASE_URL/auth/autodesk/callback
APS_CALLBACK_URL=
SESSION_DAYS=7
# ShotGrid permission groups that see every production (others: only productions they are a member of)
ROLES_SEE_ALL=Admin,Admin Copy,Manager,Supervisor,Audit - Conseil
# Groups that can run syncs and open the Synchronisation page
ADMIN_ROLES=Admin,Admin Copy
# Local development only (ignored unless APP_BASE_URL is localhost): sign in as this ShotGrid login or e-mail
DEV_LOGIN_AS=
